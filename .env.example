# Local development settings. Copy to .env (git-ignored) and adjust.
#   cp .env.example .env && docker compose up
#
# Every value here is a LOCAL-ONLY default. Real keys never go in this file or in git.

# What `docker compose up` starts:
#   infra       -> Postgres, Redis, RabbitMQ, Mailpit (run services from your IDE)
#   infra,apps  -> everything in containers (once the services exist under ./services)
COMPOSE_PROFILES=infra

# Spring profile used by containerised services: local | dev | demo
SPRING_PROFILE=dev

# Gateway exposure. Use 0.0.0.0 to let phones on your Wi-Fi reach http://<your-LAN-IP>:8080
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8080

# Browser origins allowed to call the API (comma separated, wildcards allowed).
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://booking-customer-web*.vercel.app,https://booking-admin-web*.vercel.app

# ---- Local data stores (Docker). Passwords are local defaults, not secrets.
POSTGRES_PASSWORD=postgres-local
SERVICE_DB_PASSWORD_PREFIX=local-
RABBITMQ_PASSWORD=booking-local

# ---- Providers: everything mocked by default so nothing external is called or charged.
PAYMENT_PROVIDER=mock          # mock | stripe (test mode keys only)
MAPS_PROVIDER=mock             # mock | osm (free public OSM services, rate limited)
FLIGHT_PROVIDER=mock           # mock (no free flight API with webhooks exists)
PUSH_PROVIDER=log              # log | fcm
SMS_PROVIDER=log               # log only (no free SMS)
MOCK_PAYMENT_WEBHOOK_SECRET=local-mock-webhook-secret

# Email goes to Mailpit: open http://localhost:8025 to read it.
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=bookings@local.test

# ---- Optional, only when you switch a provider on. Leave empty otherwise.
# One restricted key per service (Dashboard > Developers > API keys > Create restricted key, TEST mode):
# rk_test_... payment-service: checkout, intents, refunds, transfers, invoices
STRIPE_PAYMENTS_API_KEY=
# rk_test_... fleet-service: connected accounts, account links, login links
STRIPE_CONNECT_API_KEY=
# test key used only by the Stripe CLI container to forward webhooks
STRIPE_CLI_API_KEY=
# whsec_... printed by: docker compose --profile stripe up stripe-cli
STRIPE_WEBHOOK_SECRET=
PLATFORM_COMMISSION_BPS=2500   # platform commission per ride leg (2500 = 25%)
# base64 of the Firebase service-account JSON
FCM_SERVICE_ACCOUNT_B64=
# empty = auth generates a throwaway key on each start (local only)
AUTH_JWT_PRIVATE_KEY_B64=
# empty = auth prints a random admin password on first start
AUTH_SEED_ADMIN_PASSWORD=

# ---- Tunnel target when the gateway runs in your IDE instead of Docker:
# TUNNEL_TARGET=http://host.docker.internal:8080
