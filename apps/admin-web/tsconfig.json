{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@booking/runtime-config": [
        "../../packages/runtime-config/src/index.ts"
      ],
      "@booking/ui/*": [
        "../../packages/ui/*"
      ],
      "react": [
        "./node_modules/@types/react",
        "../../node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*",
        "../../node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/ui",
    "../../packages/runtime-config/src/index.ts"
  ]
}
