# Remote demo settings: services still run on your machine (or any free host later),
# but data lives in free hosted services so the demo survives laptop resets.
# Copy to .env (git-ignored) and fill in. Every service listed is free with no card.
COMPOSE_PROFILES=apps,tunnel
SPRING_PROFILE=demo
GATEWAY_BIND=127.0.0.1
CORS_ALLOWED_ORIGIN_PATTERNS=https://booking-customer-web.vercel.app,https://booking-admin-web.vercel.app,https://booking-customer-*-ramindusamarawickramas-projects.vercel.app,https://booking-admin-*-ramindusamarawickramas-projects.vercel.app

# ---- PostgreSQL: Supabase Free or Neon Free (one database, one schema per service).
# Supabase: use the Session pooler string (IPv4), port 5432, sslmode=require.
# Neon: use the pooled host; keep DB_POOL_SIZE small, free tiers limit connections.
DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
DB_POOL_SIZE=2
AUTH_DB_PASSWORD=
CATALOG_DB_PASSWORD=
PRICING_DB_PASSWORD=
BOOKING_DB_PASSWORD=
PAYMENT_DB_PASSWORD=
FLEET_DB_PASSWORD=
DISPATCH_DB_PASSWORD=
TRACKING_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# ---- Redis: Upstash Free (TLS, note the rediss:// scheme).
REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379

# ---- RabbitMQ: CloudAMQP "Little Lemur" free plan (TLS, amqps://).
RABBITMQ_URI=amqps://<user>:<password>@<host>.rmq.cloudamqp.com/<vhost>

# ---- Providers
PAYMENT_PROVIDER=stripe        # Stripe TEST mode only
# rk_test_... payment-service restricted key
STRIPE_PAYMENTS_API_KEY=
# rk_test_... fleet-service restricted key
STRIPE_CONNECT_API_KEY=
# whsec_... for the tunnel URL endpoint
STRIPE_WEBHOOK_SECRET=
MAPS_PROVIDER=osm
OSM_USER_AGENT=booking-engine-demo (your-email@example.com)
FLIGHT_PROVIDER=mock
PUSH_PROVIDER=fcm
FCM_SERVICE_ACCOUNT_B64=
SMS_PROVIDER=log

# Email: Brevo free SMTP (300/day) or any free SMTP relay.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# required in demo: the P-256 signing key followed by its public key, base64 encoded:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out signing.pem
#   cat signing.pem <(openssl pkey -in signing.pem -pubout) | base64 -w0
AUTH_JWT_PRIVATE_KEY_B64=
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_ADMIN_PASSWORD=
